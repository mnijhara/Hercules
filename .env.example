# Shared Cloudflare AI router used by Hercules and other AI projects.
AI_ROUTER_BASE_URL="https://getjobready-ai-proxy.mnijhara.workers.dev"
AI_ROUTER_MODEL="gemini-2.5-flash"
# Optional if the router requires authentication.
AI_ROUTER_API_KEY=""
AI_ROUTER_TIMEOUT_MS="30000"

# Optional direct Gemini fallback.
GEMINI_API_KEY=""

# Optional external lead destination. Leads are retained in the private local inbox when absent/unavailable.
LEAD_WEBHOOK_URL=""

# APP_URL: The URL where this app is hosted.
APP_URL=""

# Admin dashboard. Use a strong random password and a separate strong session secret.
# Open https://your-domain/admin after deployment.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
ANALYTICS_HASH_SALT=""

# Set true only when the deployment sits behind a trusted reverse proxy
# that supplies the real client IP via X-Forwarded-For.
TRUST_PROXY="false"
